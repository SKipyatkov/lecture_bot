# Скопируйте в .env и вставьте токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Относительные пути считаются от корня репозитория.
# Модель мультиязычная: язык записи выбирается сам.
WHISPER_MODEL_PATH=models/faster-whisper-small

# База, логи, кэш и бэкапы. В Docker это /app/data
DATA_DIR=data

# Снаружи Docker Postgres слушает localhost:5433.
# Внутри compose бот сам получает адрес сервиса postgres.
DATABASE_URL=postgresql://lecture:lecture@localhost:5433/lecture_bot

FFMPEG_PATH=ffmpeg
ESPEAK_PATH=espeak

ADMIN_PASSWORD=admin123
ADMIN_USER_ID=0

MAX_FILE_SIZE=20971520
CACHE_TTL_HOURS=24
CACHE_ENABLED=true
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
PLUGINS_ENABLED=true
